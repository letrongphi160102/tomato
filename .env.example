# ==============================================================================
# TOMATO — Mẫu biến môi trường cho toàn bộ Giai đoạn 1 (M0 - M5)
# ------------------------------------------------------------------------------
# HƯỚNG DẪN:
#   1. Sao chép file này thành `.env.local` để chạy phát triển cục bộ.
#   2. TUYỆT ĐỐI KHÔNG commit file `.env` hoặc `.env.local` lên Git.
#   3. Sinh các khóa bí mật ngẫu nhiên tối thiểu 256-bit (64 ký tự hex) bằng 1 trong 2 lệnh:
#      - OpenSSL: openssl rand -hex 32
#      - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ứng dụng & Nguồn gốc cho phép (App & CSRF Origins)
# ------------------------------------------------------------------------------
NODE_ENV=development
# Production bắt buộc dùng https:// (cookie __Host- yêu cầu HTTPS)
APP_URL=http://localhost:3000
# Danh sách Origin cho phép gọi API thay đổi dữ liệu, ngăn cách bằng dấu phẩy (mặc định lấy từ APP_URL)
ALLOWED_ORIGINS=http://localhost:3000
# Mức log Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu PostgreSQL (Local Docker / Production Neon Free Pooled)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://tomato:tomato_dev_password@127.0.0.1:5433/tomato_dev
# Số kết nối tối đa trong pool (trên Vercel Serverless khuyến nghị đặt 5)
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. Bộ nhớ đệm & Rate Limit Redis (Adapter chung: Local TCP / Upstash HTTP)
# ------------------------------------------------------------------------------
# Chọn 'local' khi dùng Redis Docker (TCP) hoặc 'upstash' khi chạy trên Vercel (HTTP REST)
REDIS_PROVIDER=local
# Bắt buộc khi REDIS_PROVIDER=local
REDIS_URL=redis://127.0.0.1:6379
# Bắt buộc khi REDIS_PROVIDER=upstash (Production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 4. Mật mã học & Xác thực (Giai đoạn 1 — Bắt buộc >= 32 ký tự / 256-bit)
#    KHÔNG dùng lại cùng một secret cho nhiều mục đích khác nhau!
# ------------------------------------------------------------------------------
# Khóa ký Access Token JWT (HS256) — sinh bằng `openssl rand -hex 32`
JWT_SECRET=replace-with-random-256-bit-hex-secret-for-jwt-signing
# Khóa HMAC-SHA256 băm mã OTP 6 chữ số — sinh bằng `openssl rand -hex 32`
OTP_SECRET=replace-with-random-256-bit-hex-secret-for-otp-hmac
# Phiên bản Pepper hiện hành dùng để băm mật khẩu mới (hỗ trợ key rotation)
CURRENT_PEPPER_VERSION=1
# JSON map { "<version>": "<secret >= 32 chars>" } — khi xoay khóa, thêm key mới vào JSON
# và nâng CURRENT_PEPPER_VERSION mà không xóa key cũ cho đến khi toàn bộ user được rehash.
PASSWORD_PEPPER_SECRETS={"1":"replace-with-random-256-bit-hex-secret-for-pepper-v1"}

# ------------------------------------------------------------------------------
# 5. Dịch vụ gửi Email (Local: Mailpit / Production 0đ: Gmail App Password hoặc Brevo)
# ------------------------------------------------------------------------------
# Chọn:
#   - 'mailpit' : Mailpit SMTP cục bộ qua Docker (bị chặn khi NODE_ENV=production)
#   - 'gmail'   : Gmail SMTP TLS (smtp.gmail.com:465) + Gmail App Password (không cần tên miền riêng)
#   - 'brevo'   : Brevo Transactional Email REST API v3 (300 email/ngày miễn phí)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Tomato <no-reply@tomato.local>
# Cấu hình SMTP (Mailpit mặc định 127.0.0.1:1025; Gmail mặc định smtp.gmail.com:465 TLS)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Bắt buộc khi EMAIL_PROVIDER=gmail (địa chỉ Gmail và App Password 16 ký tự)
SMTP_USER=
SMTP_PASS=
# Bắt buộc khi EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 6. Chống Bot — Cloudflare Turnstile
#    Dưới đây là cặp dummy test key công khai chính thức của Cloudflare (luôn pass ở local).
#    env.ts sẽ CHẶN ứng dụng khởi động nếu bạn vô tình dùng dummy key này ở NODE_ENV=production.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 7. Giám sát lỗi — Sentry Free (Tùy chọn ở local, khuyến nghị bật ở Production — M5)
#    Mọi sự kiện gửi lên Sentry đều đi qua bộ lọc `beforeSend` xóa sạch cookie/token/PII.
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Tùy chọn khi muốn upload source maps lúc build trên Vercel (KHÔNG commit token thật)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
